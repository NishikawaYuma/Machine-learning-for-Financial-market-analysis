# Notion Integration Token
# https://www.notion.so/my-integrations で取得
NOTION_TOKEN=your_notion_token

# 日次マーケットレポート DB の ID
# Notion DB URL から取得（https://www.notion.so/xxxxx?v=yyy の xxxxx 部分）
NOTION_MARKET_REPORT_DB_ID=your_notion_db_id

# GitHub Pages（インタラクティブチャート用）
# Personal Access Token（repo スコープ）: https://github.com/settings/tokens で生成
GITHUB_TOKEN=your_github_personal_access_token
# GitHub ユーザー名とリポジトリ名
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
